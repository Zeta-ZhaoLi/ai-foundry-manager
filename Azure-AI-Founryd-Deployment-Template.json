  "resources": [
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2025-09-01",
      "name": "[parameters('resourceName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('skuName')]"
      },
      "kind": "AIServices",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "allowProjectManagement": true,
        "customSubDomainName": "[parameters('resourceName')]",
        "disableLocalAuth": "[parameters('disableLocalAuth')]",
        "publicNetworkAccess": "[parameters('publicNetworkAccess')]",
        "networkAcls": {
          "defaultAction": "Allow",
          "virtualNetworkRules": [],
          "ipRules": []
        }
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2025-09-01",
      "name": "[format('{0}/{1}', parameters('resourceName'), variables('modelDeployments')[copyIndex('modelDeploymentLoop')].deploymentName)]",
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', parameters('resourceName'))]"
      ],
      "copy": {
        "name": "modelDeploymentLoop",
        "count": "[length(variables('modelDeployments'))]",
        "mode": "serial",
        "batchSize": 1
      },
      "sku": {
        "name": "GlobalStandard",
        "capacity": "[variables('modelDeployments')[copyIndex('modelDeploymentLoop')].capacity]"
      },
      "properties": {
        "model": {
          "format": "[variables('modelDeployments')[copyIndex('modelDeploymentLoop')].modelFormat]",
          "name": "[variables('modelDeployments')[copyIndex('modelDeploymentLoop')].modelName]",
          "version": "[variables('modelDeployments')[copyIndex('modelDeploymentLoop')].version]"
        },
        "versionUpgradeOption": "OnceNewDefaultVersionAvailable",
        "currentCapacity": "[variables('modelDeployments')[copyIndex('modelDeploymentLoop')].capacity]",
        "raiPolicyName": "Microsoft.Nil"
      }
    }
  ]
}
