{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "resourceName": {
      "type": "String",
      "defaultValue": "nnaelokaofodile644-8504-resource"
    },
    "location": {
      "type": "String",
      "defaultValue": "eastus2"
    },
    "skuName": {
      "type": "String",
      "defaultValue": "S0",
      "allowedValues": [
        "S0"
      ]
    },
    "publicNetworkAccess": {
      "type": "String",
      "defaultValue": "Enabled",
      "allowedValues": [
        "Enabled",
        "Disabled"
      ]
    },
    "disableLocalAuth": {
      "type": "Bool",
      "defaultValue": false,
      "metadata": {
        "description": "true = 仅 Entra ID（禁用 API Key）；false = 允许 API Key（更接近 Azure OpenAI 旧用法）"
      }
    }
  },
  "variables": {
    "modelDeployments": [
      {
        "deploymentName": "gpt-4o-2024-05-13",
        "modelName": "gpt-4o-2024-05-13",
        "version": "2024-05-13",
        "capacity": 450
      },
      {
        "deploymentName": "gpt-4o-2024-08-06",
        "modelName": "gpt-4o-2024-08-06",
        "version": "2024-08-06",
        "capacity": 450
      },
      {
        "deploymentName": "gpt-4o-2024-11-20",
        "modelName": "gpt-4o-2024-11-20",
        "version": "2024-11-20",
        "capacity": 450
      },
      {
        "deploymentName": "gpt-4o-mini-2024-07-18",
        "modelName": "gpt-4o-mini-2024-07-18",
        "version": "2024-07-18",
        "capacity": 2000
      },
      {
        "deploymentName": "gpt-4.1-2025-04-14",
        "modelName": "gpt-4.1-2025-04-14",
        "version": "2025-04-14",
        "capacity": 1000
      },
      {
        "deploymentName": "gpt-4.1-mini-2025-04-14",
        "modelName": "gpt-4.1-mini-2025-04-14",
        "version": "2025-04-14",
        "capacity": 5000
      },
      {
        "deploymentName": "gpt-4.1-nano-2025-04-14",
        "modelName": "gpt-4.1-nano-2025-04-14",
        "version": "2025-04-14",
        "capacity": 5000
      },
      {
        "deploymentName": "gpt-5-2025-08-07",
        "modelName": "gpt-5",
        "version": "2025-08-07",
        "capacity": 1000
      },
      {
        "deploymentName": "gpt-5-mini-2025-08-07",
        "modelName": "gpt-5-mini-2025-08-07",
        "version": "2025-08-07",
        "capacity": 1000
      },
      {
        "deploymentName": "gpt-5-nano-2025-08-07",
        "modelName": "gpt-5-nano-2025-08-07",
        "version": "2025-08-07",
        "capacity": 5000
      },
      {
        "deploymentName": "gpt-5.1-2025-11-13",
        "modelName": "gpt-5.1",
        "version": "2025-11-13",
        "capacity": 1000
      },
      {
        "deploymentName": "gpt-5.2-2025-12-11",
        "modelName": "gpt-5.2",
        "version": "2025-12-11",
        "capacity": 1000
      },
      {
        "deploymentName": "gpt-5-chat-latest",
        "modelName": "gpt-5-chat-latest",
        "version": "2025-10-03",
        "capacity": 1000
      },
      {
        "deploymentName": "gpt-5.1-chat-latest",
        "modelName": "gpt-5.1-chat-latest",
        "version": "2025-11-13",
        "capacity": 1000
      },
      {
        "deploymentName": "gpt-5.2-chat-latest",
        "modelName": "gpt-5.2-chat-latest",
        "version": "2025-12-11",
        "capacity": 1000
      },
      {
        "deploymentName": "gpt-5-codex",
        "modelName": "gpt-5-codex",
        "version": "2025-09-15",
        "capacity": 1000
      },
      {
        "deploymentName": "gpt-5.1-codex",
        "modelName": "gpt-5.1-codex",
        "version": "2025-11-13",
        "capacity": 1000
      },
      {
        "deploymentName": "gpt-5.1-codex-max",
        "modelName": "gpt-5.1-codex-max",
        "version": "2025-12-04",
        "capacity": 1000
      },
      {
        "deploymentName": "gpt-5.1-codex-mini",
        "modelName": "gpt-5.1-codex-mini",
        "version": "2025-11-13",
        "capacity": 1000
      },
      {
        "deploymentName": "gpt-5.2-codex",
        "modelName": "gpt-5.2-codex",
        "version": "2026-01-14",
        "capacity": 1000
      }
    ]
  },
  "resources": [
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2025-09-01",
      "name": "[parameters('resourceName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('skuName')]"
      },
      "kind": "AIServices",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "allowProjectManagement": true,
        "customSubDomainName": "[parameters('resourceName')]",
        "disableLocalAuth": "[parameters('disableLocalAuth')]",
        "publicNetworkAccess": "[parameters('publicNetworkAccess')]",
        "networkAcls": {
          "defaultAction": "Allow",
          "virtualNetworkRules": [],
          "ipRules": []
        }
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2025-09-01",
      "name": "[format('{0}/{1}', parameters('resourceName'), variables('modelDeployments')[copyIndex('modelDeploymentLoop')].deploymentName)]",
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', parameters('resourceName'))]"
      ],
      "copy": {
        "name": "modelDeploymentLoop",
        "count": "[length(variables('modelDeployments'))]",
        "mode": "serial",
        "batchSize": 1
      },
      "sku": {
        "name": "GlobalStandard",
        "capacity": "[variables('modelDeployments')[copyIndex('modelDeploymentLoop')].capacity]"
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[variables('modelDeployments')[copyIndex('modelDeploymentLoop')].modelName]",
          "version": "[variables('modelDeployments')[copyIndex('modelDeploymentLoop')].version]"
        },
        "versionUpgradeOption": "OnceNewDefaultVersionAvailable",
        "currentCapacity": "[variables('modelDeployments')[copyIndex('modelDeploymentLoop')].capacity]",
        "raiPolicyName": "Microsoft.Nil"
      }
    }
  ]
}
